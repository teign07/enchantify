# Enchantify-local YouTube read integration.
# Copy to config/youtube.env and fill in values. youtube.env is gitignored.

# Google Cloud API key with YouTube Data API v3 enabled.
YT_KEY=

# Your YouTube channel ID, usually starts with UC.
YT_CH_ID=

# Optional OAuth layer for account-owned reads and future upload support.
# Create an OAuth client in Google Cloud Console. Desktop app is easiest.
YT_CLIENT_ID=
YT_CLIENT_SECRET=
YT_REDIRECT_URI=http://127.0.0.1:8765/oauth2callback
YT_ACCESS_TOKEN=
YT_REFRESH_TOKEN=
YT_TOKEN_EXPIRES_AT=
