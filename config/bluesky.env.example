# Enchantify-local Bluesky / AT Protocol integration.
# Copy to config/bluesky.env and fill in values. bluesky.env is gitignored.
#
# Recommended: create an app password in Bluesky:
# Settings -> Privacy and Security -> App Passwords
#
# Example handle: enchantify.bsky.social

BLUESKY_SERVICE=https://bsky.social
BLUESKY_HANDLE=
BLUESKY_APP_PASSWORD=

# Saved by scripts/bluesky-adapter.py login when successful.
BLUESKY_DID=
BLUESKY_ACCESS_JWT=
BLUESKY_REFRESH_JWT=
BLUESKY_TOKEN_CREATED_AT=
