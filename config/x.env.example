# Enchantify-local X / Twitter integration.
# Copy to config/x.env and fill in values. x.env is gitignored.

# Create an app at https://developer.x.com/ or https://console.x.com/.
X_CLIENT_ID=
X_CLIENT_SECRET=
X_REDIRECT_URI=http://127.0.0.1:8766/oauth2callback

# Saved by scripts/x-adapter.py auth-server / exchange-code.
X_ACCESS_TOKEN=
X_REFRESH_TOKEN=
X_TOKEN_EXPIRES_AT=
X_OAUTH_SCOPE=
X_CODE_VERIFIER=

# Optional OAuth 1.0a user-context tokens.
# These avoid browser OAuth loops and can verify account status/post later
# through consent-gated scripts.
X_BEARER_TOKEN=
X_CONSUMER_KEY=
X_CONSUMER_SECRET=
X_ACCESS_TOKEN_V1=
X_ACCESS_TOKEN_SECRET_V1=
